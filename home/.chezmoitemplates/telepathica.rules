# Managed by chezmoi (dotfiles home/.chezmoitemplates/telepathica.rules, installed as ~/.codex/rules and ~/.codex-work/rules telepathica.rules).
# Telepathica talks to Royal's astronomican at http://astronomican.royal-burbot.ts.net:47100, which
# the workspace-write sandbox cannot reach (os error 10013 on Windows), so these
# run outside the sandbox. Only subcommands that carry no message body are
# allowed here. send, notify, reply and release keep going through escalation and
# auto_review, which applies "Telepathica commands" in
# ~/.agents/authorization-policy.md (payload limits, task scope).
prefix_rule(
    pattern = [
        [
            "telepathica",
            "telepathica.exe",
            "telepathica.EXE",
{{- $home := replace "\\" "/" .chezmoi.homeDir }}
{{- if eq .chezmoi.os "windows" }}
{{- range $exe := list "telepathica.exe" "telepathica.EXE" }}
{{- $p := printf "%s/.local/bin/%s" $home $exe }}
            {{ $p | quote }},
            {{ replace "/" "\\" $p | quote }},
{{- end }}
{{- else }}
            {{ printf "%s/.local/bin/telepathica" $home | quote }},
{{- end }}
        ],
        ["find", "inbox", "thread", "whoami", "ack", "archive"],
    ],
    decision = "allow",
    justification = "Telepathica lookups, acks and reversible T3 archives on Royal's own astronomican",
    match = [
        "telepathica find THROWAWAY --host desktop-o91444g",
        "telepathica.exe archive --undo mcp:3f1cb692-e6fc-4ae1-9ec4-3137eb699e1c",
        "telepathica inbox",
    ],
    not_match = [
        "telepathica send --to codex@harbor hello",
        "telepathica release ship 1.7.0",
        "telepathica bypass",
        "curl http://astronomican.royal-burbot.ts.net:47100/v1/find",
    ],
)
