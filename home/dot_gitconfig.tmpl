[user]
	name = Royalaid
	email = 2439803+royalaid@users.noreply.github.com

[core]
	# input + eol=lf everywhere, including Windows. This host edits the same
	# trees from Windows and from WSL over \\wsl.localhost, so checking out
	# CRLF on the Windows side would show every file as modified from the
	# other side. Do not "fix" this to autocrlf=true.
	autocrlf = input
	eol = lf
	editor = {{ if lookPath "cursor" }}cursor --wait{{ else if lookPath "nvim" }}nvim{{ else }}vi{{ end }}
{{- if lookPath "delta" }}
	pager = delta
{{- end }}
{{- if stat (joinPath .chezmoi.homeDir ".gitignore") }}
	excludesfile = {{ .chezmoi.homeDir | replace "\\" "/" }}/.gitignore
{{- end }}
{{ if lookPath "delta" }}
[interactive]
	diffFilter = delta --color-only

[delta]
	features = side-by-side line-numbers decorations
	syntax-theme = Dracula
	plus-style = syntax "#003800"
	minus-style = syntax "#3f0001"

[delta "decorations"]
	commit-decoration-style = bold yellow box ul
	file-style = bold yellow ul
	file-decoration-style = none
	hunk-header-decoration-style = cyan box ul

[delta "line-numbers"]
	line-numbers-left-style = cyan
	line-numbers-right-style = cyan
	line-numbers-minus-style = 124
	line-numbers-plus-style = 28
{{ end }}
{{- if lookPath "git-lfs" }}
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
{{ end }}
[init]
	defaultBranch = main

[rerere]
	enabled = true
	autoupdate = true

# Machine-local git settings: credential helpers, per-host identity, and the
# safe.directory list. `gh auth setup-git` writes its helper blocks to the
# global config, and safe.directory accumulates per machine, so without this
# include a chezmoi apply would delete both and break auth and repo access.
# Deliberately untracked; git ignores the include when the file is absent.
#
# Forward slashes are required even on Windows: git treats a backslash in a
# config VALUE as an escape, so C:\Users\... is a parse error, not a path.
[include]
	path = {{ .chezmoi.homeDir | replace "\\" "/" }}/.gitconfig.local
