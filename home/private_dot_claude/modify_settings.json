{{- /* chezmoi:modify-template */ -}}
{{- /*
  Claude Code owns ~/.claude/settings.json and rewrites it constantly (plugins,
  hooks, effort level), so the file stays machine-local. This template passes
  every key through untouched except the one it strips below.

  Removed 2026-10-08: modelSettings.claude-haiku-5-5.autoCompactWindow (100000).
  It had pinned Haiku 5.5 to compact at 100K tokens, because the API price steps
  up above 100K-token prompts. That compaction thrashed a delegated Haiku worker
  that read a few large files (three compacts in three turns, then the run died),
  so Royal chose to drop the cap and accept the higher per-token price past 100K.
  The template now deletes the key so every host converges on the next apply.
  Delete this template once all hosts have applied it.
*/ -}}
{{- $settings := dict -}}
{{- if trim .chezmoi.stdin -}}
{{-   $settings = fromJson .chezmoi.stdin -}}
{{- end -}}
{{- if hasKey $settings "modelSettings" -}}
{{-   $ms := index $settings "modelSettings" -}}
{{-   if hasKey $ms "claude-haiku-5-5" -}}
{{-     $h := index $ms "claude-haiku-5-5" -}}
{{-     $_ := unset $h "autoCompactWindow" -}}
{{-     if not $h -}}
{{-       $_ := unset $ms "claude-haiku-5-5" -}}
{{-     end -}}
{{-   end -}}
{{- end -}}
{{- /*
  Added 2026-10-08: outbound messages always ask. Scheduled sweeps (inbox-sweep)
  read Slack and Gmail unattended; an ask rule stops any send there for a human,
  instead of relying on hooks or the auto-mode classifier.
  Added 2026-10-14: work Slack moved to Composio (slack-composio skill), so its
  send, schedule, upload and reaction slugs, and composio proxy and run, ask too.
*/ -}}
{{- $ask := list "mcp__plugin_slack_slack__slack_send_message" "mcp__plugin_slack_slack__slack_schedule_message" "Bash(gws gmail users messages send:*)" "Bash(gws gmail users drafts send:*)" "Bash(composio execute SLACK_SEND_MESSAGE:*)" "Bash(composio execute SLACK_CHAT_POST_MESSAGE:*)" "Bash(composio execute SLACK_SEND_ME_MESSAGE:*)" "Bash(composio execute SLACK_SEND_EPHEMERAL_MESSAGE:*)" "Bash(composio execute SLACK_SCHEDULE_MESSAGE:*)" "Bash(composio execute SLACK_UPLOAD_OR_CREATE_A_FILE_IN_SLACK:*)" "Bash(composio execute SLACK_ADD_REACTION_TO_AN_ITEM:*)" "Bash(composio proxy:*)" "Bash(composio run:*)" -}}
{{- /*
  Added 2026-10-14: the Ramp MCP (server "ramp", FISI Development) asks before
  every tool that changes state; the list is .chezmoidata/ramp.yaml. Both name
  forms are listed until the live tool names are confirmed after OAuth.
*/ -}}
{{- range .ramp.writeTools -}}
{{-   $ask = append $ask (printf "mcp__ramp__%s" .) -}}
{{-   $ask = append $ask (printf "mcp__ramp__%s" (trimPrefix "ramp_" .)) -}}
{{- end -}}
{{- $perms := dict -}}
{{- if hasKey $settings "permissions" -}}
{{-   $perms = index $settings "permissions" -}}
{{- end -}}
{{- $cur := list -}}
{{- if hasKey $perms "ask" -}}
{{-   $cur = index $perms "ask" -}}
{{- end -}}
{{- range $ask -}}
{{-   if not (has . $cur) -}}
{{-     $cur = append $cur . -}}
{{-   end -}}
{{- end -}}
{{- $_ := set $perms "ask" $cur -}}
{{- /*
  Added 2026-10-13: Telepathica's commands that carry no message body run
  without the auto-mode classifier, which had denied `telepathica archive` as
  [External System Writes] when Royal's request was general ("archive
  everything that's done"). send, notify, reply, release and shell loops stay
  with the classifier, which reads "Telepathica commands" in
  ~/.agents/authorization-policy.md. The Codex twin is
  ~/.codex/rules/telepathica.rules.
*/ -}}
{{- $tbins := list "telepathica" "telepathica.exe" "telepathica.EXE" "~/.local/bin/telepathica" -}}
{{- $home := replace "\\" "/" .chezmoi.homeDir -}}
{{- if eq .chezmoi.os "windows" -}}
{{-   range $exe := list "telepathica.exe" "telepathica.EXE" -}}
{{-     $p := printf "%s/.local/bin/%s" $home $exe -}}
{{-     $tbins = concat $tbins (list $p (replace "/" "\\" $p)) -}}
{{-   end -}}
{{- else -}}
{{-   $tbins = append $tbins (printf "%s/.local/bin/telepathica" $home) -}}
{{- end -}}
{{- $allow := list -}}
{{- if hasKey $perms "allow" -}}
{{-   $allow = index $perms "allow" -}}
{{- end -}}
{{- range $tool := list "Bash" "PowerShell" -}}
{{-   range $bin := $tbins -}}
{{-     range $sub := list "find" "inbox" "thread" "whoami" "ack" "archive" -}}
{{-       $rule := printf "%s(%s %s:*)" $tool $bin $sub -}}
{{-       if not (has $rule $allow) -}}
{{-         $allow = append $allow $rule -}}
{{-       end -}}
{{-     end -}}
{{-   end -}}
{{- end -}}
{{- $_ := set $perms "allow" $allow -}}
{{- $_ := set $settings "permissions" $perms -}}
{{- toPrettyJson $settings | trim }}
