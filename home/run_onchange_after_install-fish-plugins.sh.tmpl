#!/bin/sh
# Bootstraps fisher and syncs fish plugins from ~/.config/fish/fish_plugins,
# which is the single source of truth. The plugin files themselves are NOT
# tracked by chezmoi (see .chezmoiignore) — tracking them made fisher fail with
# "file already exists" on a fresh machine. This run_onchange script re-runs
# whenever fish_plugins changes (its hash is embedded below).
#
# fish_plugins hash: {{ include "dot_config/private_fish/fish_plugins" | sha256sum }}

set -eu

if ! command -v fish >/dev/null 2>&1; then
    echo "fish not installed; skipping fisher bootstrap" >&2
    exit 0
fi

fish -c '
    if not functions -q fisher
        echo "Bootstrapping fisher..."
        curl -fsSL https://raw.githubusercontent.com/jorgebucaran/fisher/main/functions/fisher.fish | source
    end
    # Reconciles installed plugins against fish_plugins (installs fisher itself too).
    fisher update
'
